<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Honda | Limitlerin Ötesinde</title>
	<link rel="icon" type="image/png(foto turu)" href="https://upload.wikimedia.org/wikipedia/commons/thumb/3/38/Honda.svg/960px-Honda.svg.png">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Montserrat:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        :root {
            --honda-red: #cc0000;
            --black: #0a0a0a;
            --gray: #1a1a1a;
            --white: #ffffff;
            --light-gray: #f8f8f8;
            --transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Montserrat', sans-serif; background: var(--white); color: #333; overflow-x: hidden; scroll-behavior: smooth; }

        /* --- Navigasyon --- */
        nav {
            background: rgba(10, 10, 10, 0.95);
            padding: 15px 10%;
            display: flex; justify-content: space-between; align-items: center;
            position: fixed; width: 100%; z-index: 2000;
            border-bottom: 3px solid var(--honda-red);
            backdrop-filter: blur(10px);
        }

        .logo { font-family: 'Orbitron', sans-serif; color: var(--white); font-size: 1.8rem; letter-spacing: 3px; cursor: pointer; }
        .logo span { color: var(--honda-red); }

        .nav-links { display: flex; list-style: none; }
        .nav-links li { margin-left: 25px; }
        .nav-links a { 
            color: var(--white); text-decoration: none; font-weight: 700; 
            font-size: 0.75rem; text-transform: uppercase; transition: var(--transition);
            letter-spacing: 1px;
        }
        .nav-links a:hover { color: var(--honda-red); }

        /* --- Sayfa Geçişleri --- */
        .page-content { display: none; padding-top: 80px; min-height: 100vh; animation: fadeInUp 0.7s ease; }
        .page-content.active { display: block; }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* --- Ortak Bileşenler --- */
        .container { padding: 60px 10%; }
        .section-title { font-family: 'Orbitron'; font-size: 2.2rem; text-align: center; margin-bottom: 60px; position: relative; letter-spacing: 2px; }
        .section-title::after { content: ''; width: 60px; height: 4px; background: var(--honda-red); position: absolute; bottom: -15px; left: 50%; transform: translateX(-50%); }
        .sub-heading { font-family: 'Orbitron'; font-size: 1.5rem; color: var(--honda-red); margin: 40px 0 20px; text-transform: uppercase; border-left: 5px solid var(--honda-red); padding-left: 15px; }

        /* --- Ana Sayfa --- */
        .hero {
            height: 100vh;
            position: relative;
            display: flex; 
            flex-direction: column; 
            justify-content: center; 
            align-items: center; 
            color: white;
            text-align: center;
        }

        .hero-bg-img {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            object-fit: cover;
            z-index: 1;
        }

        .hero-overlay {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.7));
            z-index: 2;
        }

        .hero h1 { font-family: 'Orbitron'; font-size: 4rem; letter-spacing: 5px; margin-bottom: 10px; }
        .hero h1, .hero p, .hero button { position: relative; z-index: 3; }

        /* --- Tarihçe --- */
        .history-item { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; margin-bottom: 100px; }
        .history-item img { width: 100%; border-radius: 10px; box-shadow: 15px 15px 0 var(--honda-red); transition: var(--transition); }
        .history-item:nth-child(even) { direction: rtl; }
        .history-item:nth-child(even) .text-box { direction: ltr; }
        .text-box h3 { font-family: 'Orbitron'; font-size: 1.8rem; color: var(--honda-red); margin-bottom: 25px; }
        .text-box p { line-height: 1.8; font-size: 1rem; color: #444; }

        /* --- Modeller --- */
        .models-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); 
            gap: 40px; 
        }
        
        .car-card { 
            background: #ffffff; 
            border-radius: 20px; 
            overflow: hidden; 
            position: relative; 
            transition: var(--transition); 
            border: 1px solid #eaeaea;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
        }

        .car-card:hover { 
            transform: translateY(-15px); 
            border-color: var(--honda-red); 
            box-shadow: 0 20px 40px rgba(0,0,0,0.12); 
        }

        .car-card img { 
            width: 100%; 
            height: 220px; 
            object-fit: contain;
            background: #fcfcfc;
            padding: 25px;
            border-bottom: 1px solid #f0f0f0;
        }

        .car-info { padding: 30px; flex-grow: 1; display: flex; flex-direction: column; }
        .car-info h3 { font-family: 'Orbitron'; margin-bottom: 15px; font-size: 1.3rem; color: var(--black); }
        .car-info p { font-size: 0.95rem; color: #666; line-height: 1.6; margin-bottom: 20px; flex-grow: 1; }
        .car-price { color: var(--honda-red); font-weight: 700; font-size: 1.2rem; border-top: 1px solid #eee; padding-top: 15px; }

        /* --- MOTORLAR & MOTOSİKLETLER CSS --- */
        .engine-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
            gap: 30px; 
            margin-bottom: 60px;
        }
        .engine-card { 
            background: var(--white); 
            border-radius: 20px; 
            overflow: hidden;
            border: 1px solid #eee;
            transition: var(--transition);
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .engine-card:hover { transform: scale(1.03); border-color: var(--honda-red); }
        .engine-img-box { width: 100%; height: 200px; overflow: hidden; background: #000; }
        .engine-img-box img { width: 100%; height: 100%; object-fit: cover; opacity: 0.8; transition: 0.5s; }
        .engine-card:hover .engine-img-box img { opacity: 1; transform: scale(1.1); }
        .engine-content { padding: 25px; }
        .engine-content h3 { font-family: 'Orbitron'; margin-bottom: 10px; color: var(--black); font-size: 1.1rem; }
        .engine-content p { font-size: 0.85rem; line-height: 1.5; color: #666; }

        /* --- Karşılaştırma Tablosu --- */
        .table-wrapper { overflow-x: auto; border-radius: 20px; border: 1px solid #eee; }
        table { width: 100%; border-collapse: collapse; background: white; }
        th { background: var(--black); color: white; padding: 25px; font-family: 'Orbitron'; letter-spacing: 1px; }
        td { padding: 22px; border: 1px solid #f0f0f0; text-align: center; font-size: 0.95rem; }
        tr:hover { background: #fffcfc; }
        .spec-label { background: #fafafa; text-align: left; font-weight: 700; width: 220px; color: var(--black); }

        /* --- İletişim --- */
        .contact-wrapper { display: grid; grid-template-columns: 1fr 1.5fr; gap: 60px; background: #fff; padding: 60px; border-radius: 30px; box-shadow: 0 20px 50px rgba(0,0,0,0.05); }
        .contact-info h3 { font-family: 'Orbitron'; color: var(--black); font-size: 1.5rem; }
        .contact-info p { margin-bottom: 20px; display: flex; align-items: center; font-size: 1rem; }
        .contact-info i { color: var(--honda-red); font-size: 1.3rem; margin-right: 20px; width: 30px; }
        
        input, select, textarea { width: 100%; padding: 18px; margin-bottom: 20px; border: 2px solid #f0f0f0; border-radius: 12px; outline: none; font-family: inherit; transition: 0.3s; }
        input:focus, textarea:focus { border-color: var(--honda-red); background: #fff; }
        
        .btn-submit { 
            background: var(--honda-red); color: white; border: none; padding: 18px 40px; 
            border-radius: 12px; font-weight: 700; font-family: 'Orbitron'; cursor: pointer; 
            transition: var(--transition); width: 100%; letter-spacing: 1px;
        }
        .btn-submit:hover { background: var(--black); transform: translateY(-3px); box-shadow: 0 10px 20px rgba(204, 0, 0, 0.2); }

        footer { background: var(--black); color: rgba(255,255,255,0.7); padding: 80px 10%; text-align: center; }
        .social-icons { margin-bottom: 30px; }
        .social-icons i { font-size: 1.5rem; margin: 0 20px; cursor: pointer; transition: 0.3s; color: white; }
        .social-icons i:hover { color: var(--honda-red); transform: scale(1.2); }

        @media (max-width: 992px) {
            .history-item, .contact-wrapper { grid-template-columns: 1fr; gap: 40px; }
            .hero h1 { font-size: 2.8rem; }
            .container { padding: 40px 5%; }
        }
    </style>
</head>
